# PayPal Developer sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave empty to run in mock mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: sandbox business account email that receives captured funds (the room host)
PAYPAL_HOST_PAYEE_EMAIL=
# Optional: webhook id for signature verification of /api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Autonomous treasurer agent (https://aistudio.google.com/apikey). Without it a rule engine runs instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AGENT_INTERVAL_MS=45000

# Upstream model the proxy forwards to. Priority: UPSTREAM_* > GROQ_API_KEY > GEMINI_API_KEY > mock.
# Groq's free tier serves openai/gpt-oss-120b, openai/gpt-oss-20b and qwen/qwen3.8-27b (https://console.groq.com/keys).
GROQ_API_KEY=
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=

# Optional: room notices (price changes, top-up requests) are POSTed here, e.g. a Zapier catch hook or Slack webhook
NOTIFY_WEBHOOK_URL=
